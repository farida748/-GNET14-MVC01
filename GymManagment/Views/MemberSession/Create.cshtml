@model GymManagment.Models.MemberSession

@{
    ViewData["Title"] = "Create New Booking";

    var members = ViewBag.Members as List<GymManagment.Models.Member>;
    var sessionId = ViewBag.SessionId;
}

<h1>Create New Booking</h1>

<hr />

<div class="row">
    <div class="d-flex justify-content-center align-items-center h-100">

        <div class="col-md-6">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">Booking Information</h5>
                </div>

                <div class="card-body">

                    <form asp-controller="MemberSession"
                          asp-action="Create"
                          method="post">

                        <input type="hidden" name="sessionId" value="@sessionId" />

                        <div class="mb-3">

                            <label class="form-label">Member</label>

                            <select name="memberId" id="MemberId" class="form-select" required>
                                <option value="">-- Select Member --</option>

                                @if (members != null && members.Any())
                                {
                                    @foreach (var member in members)
                                    {
                                        <option value="@member.Id">
                                            @member.FullName
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        <div class="mb-3">

                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i>
                                Create Booking
                            </button>

                            <a asp-controller="MemberSession"
                               asp-action="GetMembersForUpcomingSession"
                               asp-route-sessionId="@sessionId"
                               class="btn btn-secondary">

                                <i class="fas fa-arrow-left"></i>
                                Back to List
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>

<script src="~/js/jquery.validate.min.js"></script>
<script src="~/js/jquery.validate.unobtrusive.min.js"></script>

<script>
    $(document).ready(function () {
        $('#MemberId').select2({
            placeholder: "Select a member",
            allowClear: true,
            width: '100%'
        });
    });
</script>