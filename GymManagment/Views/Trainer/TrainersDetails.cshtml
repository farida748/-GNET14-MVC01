@model GymManagment.Models.Trainer

@{
    ViewData["Title"] = "Trainer Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="shortcut icon" href="~/images/icon.svg" type="image/x-icon" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/style.css" />

    <title>Power fitness | Trainer Details</title>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg bg-white my-3">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.jpg" alt="Power Fitness Logo" />
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">

                    <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Member"
                               asp-action="Index">
                                Members
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link active px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Trainer"
                               asp-action="Index">
                                Trainers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Session"
                               asp-action="Index">
                                Sessions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Plan"
                               asp-action="Index">
                                Plans
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Membership"
                               asp-action="Index">
                                Memberships
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="MemberSession"
                               asp-action="Index">
                                Sessions Schedule
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">

            <div class="container mt-5">
                <div class="row justify-content-center">

                    <div class="col-md-6">

                        <div class="card shadow-lg border-0">

                            <div class="card-header bg-primary-color text-white text-center py-5">

                                <i class="bi bi-person-badge display-4 mb-3"></i>

                                <h2 class="mb-0">
                                    @Model.Name
                                </h2>

                                <span class="badge bg-light text-primary-color mt-2">
                                    @Model.Specialty Trainer
                                </span>

                            </div>

                            <div class="card-body p-4">

                                <div class="plan-details">

                                    <div class="detail-item mb-4">
                                        <div class="d-flex align-items-center mb-2">

                                            <div class="icon-box me-3">
                                                <i class="bi bi-envelope text-primary-color fs-4"></i>
                                            </div>

                                            <div>
                                                <h6 class="mb-0 text-muted">Email</h6>
                                                <p class="mb-0 fw-bold">@Model.Email</p>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="detail-item mb-4">
                                        <div class="d-flex align-items-center mb-2">

                                            <div class="icon-box me-3">
                                                <i class="bi bi-telephone text-primary-color fs-4"></i>
                                            </div>

                                            <div>
                                                <h6 class="mb-0 text-muted">Phone</h6>
                                                <p class="mb-0 fw-bold">@Model.Phone</p>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="detail-item mb-4">
                                        <div class="d-flex align-items-center mb-2">

                                            <div class="icon-box me-3">
                                                <i class="bi bi-calendar-date text-primary-color fs-4"></i>
                                            </div>

                                            <div>
                                                <h6 class="mb-0 text-muted">Date Of Birth</h6>
                                                <p class="mb-0 fw-bold">
                                                    @Model.DateOfBirth.ToString("MM/dd/yyyy")
                                                </p>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="detail-item mb-4">
                                        <div class="d-flex align-items-center mb-2">

                                            <div class="icon-box me-3">
                                                <i class="bi bi-geo-alt text-primary-color fs-4"></i>
                                            </div>

                                            <div>
                                                <h6 class="mb-0 text-muted">Address</h6>
                                                <p class="mb-0 fw-bold">@Model.Adress</p>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between gap-2 px-3 pb-3">

                                        <a asp-controller="Trainer"
                                           asp-action="Index"
                                           class="btn btn-fill flex-fill">
                                            Back to List
                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            </div>

        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>