@model GymManagment.Models.Trainer

@{
    ViewData["Title"] = "Delete Trainer";
}

<div class="container mt-5">
    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card p-5 shadow text-center">

                <p class="fs-3 text-primary-color mb-4">
                    Are you sure you want to delete this Trainer?
                </p>

                <div class="mb-3">
                    <h4 class="fw-bold">@Model.Name</h4>
                    <p class="text-muted mb-1">@Model.Email</p>
                    <p class="text-muted mb-1">@Model.Phone</p>
                    <span class="badge bg-primary-color">@Model.Specialty</span>
                </div>

                <div class="alert alert-warning text-start" role="alert">
                    <strong>Warning!</strong>
                    This action cannot be undone. All Trainer data will be permanently deleted.
                </div>

                <form asp-controller="Trainer"
                      asp-action="DeleteConfirmed"
                      method="post"
                      class="mt-4">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="buttons d-flex justify-content-between gap-3">

                        <a asp-controller="Trainer"
                           asp-action="Index"
                           class="btn-outline flex-fill text-center">
                            NO
                        </a>

                        <button type="submit" class="btn-fill flex-fill">
                            Yes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>